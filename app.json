{
  "expo": {
    "name": "C-Ride Driver",
    "slug": "c-ride-dispatch-rider-app",
  "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/c-ride-icon.png",
    "scheme": "cridedispatchriderapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.albacorre.cridedriver",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/images/c-ride-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Your location is required to find nearby delivery jobs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "While you are online, C-Ride Driver shares your location even when the app is closed, so you keep receiving nearby jobs and customers can follow their delivery.",
        "UIBackgroundModes": ["remote-notification", "location"]
      }
    },

    "android": {
      "package": "com.albacorre.cridedriver",
      "versionCode": 18,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "react-native-maps",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is required to find nearby delivery jobs.",
          "locationAlwaysAndWhenInUsePermission": "While you are online, C-Ride Driver shares your location even when the app is closed, so you keep receiving nearby jobs and customers can follow their delivery.",
          "locationAlwaysPermission": "While you are online, C-Ride Driver shares your location even when the app is closed, so you keep receiving nearby jobs and customers can follow their delivery.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "motionUsagePermission": "C-Ride Driver may use motion data to improve the accuracy of your location while you are making deliveries."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "ios_auto_register_for_remote_messages": true
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f046efe-b08e-4d70-a3e7-0fe324e8f2ff"
      }
    }
  }
}
